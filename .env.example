# Polymarket Agent - Environment Variables
# Copy to .env and fill in values

# Execution mode: "paper" or "live"
EXECUTION_MODE=paper

# Polymarket wallet private key (for live trading)
POLYMARKET_PRIVATE_KEY=

# AWS (for Bedrock LLM calls)
# If running on EC2 with IAM role, these are not needed
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# NewsAPI (free tier: https://newsapi.org)
NEWSAPI_KEY=

# Telegram alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Database path
DB_PATH=agent.db
